input {
    mouse {
        accel-speed -0.4
        accel-profile "flat"
        natural-scroll
    }
    touchpad {
        tap
        accel-speed 0.0
        natural-scroll
        dwt
    }
    keyboard {
        xkb {
            layout "us"
            options "caps:ctrl_modifier"
        }
    }
}

