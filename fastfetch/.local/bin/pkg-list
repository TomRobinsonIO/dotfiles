#!/bin/bash
# Count outdated packages - output is ONLY the count

if [[ "$(uname)" == "Darwin" ]]; then
  # macOS - Homebrew
  echo "$(brew outdated 2>/dev/null | grep -cE '^[a-zA-Z0-9]')"
else
  # Linux - detect package manager and count
  if command -v dnf &>/dev/null; then
    dnf check-update --quiet 2>/dev/null | grep -cE '^[a-zA-Z]' || echo 0
  elif command -v apt-get &>/dev/null; then
    apt list --upgradable 2>/dev/null | grep -c '/[a-z]' || echo 0
  elif command -v pacman &>/dev/null; then
    pacman -Qu 2>/dev/null | wc -l | tr -d '[:space:]'
  else
    echo 0
  fi
fi
